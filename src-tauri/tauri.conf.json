{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LeanLander",
  "version": "0.1.0",
  "identifier": "dev.leanlander.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LeanLander",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "João Galego",
    "homepage": "https://github.com/JGalego/LeanLander",
    "copyright": "Copyright (c) 2026 João Galego",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "A focused desktop IDE for Lean 4",
    "longDescription": "LeanLander is a focused, cross-platform desktop IDE for exploring Lean 4 projects, editing proofs, managing toolchains, and diagnosing project environments.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      },
      "wix": {
        "upgradeCode": "681cae45-ebd9-53c2-96d5-feacc67aef25",
        "language": "en-US"
      }
    },
    "macOS": {
      "bundleName": "LeanLander",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
